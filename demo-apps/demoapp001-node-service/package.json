    "test:unit": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@lop/domain-core": "0.1.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
